# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Safe to expose. The anon key can only read posts that RLS marks published.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Only needed if you're sharing a project with another app that already has a
# table called "posts". Defaults to "posts".
# NEXT_PUBLIC_POSTS_TABLE=portfolio_posts

# SECRET. Bypasses RLS entirely — this is the only key that can write posts.
# Used by scripts/publish.mjs from your machine. Never add it to Vercel's
# client-side env, never commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Instant publish (optional — without these a new post appears within ~60s)
# ---------------------------------------------------------------------------

SITE_URL=https://your-domain.com
# Any long random string. Must match on Vercel and in .env.local.
# Generate one with:  openssl rand -hex 32
REVALIDATE_SECRET=
